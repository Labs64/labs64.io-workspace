# Ecosystem repositories are cloned as siblings of this workspace (`just clone`),
# so they never belong here. Kept as a guard against legacy in-tree checkouts.
/labs64.io-*/

# --- AI Tooling ---
.claude/*
.codex/*
.agents/*
!.agents/skills/
# Nothing under .agents/skills/ should ever be a tool-auto-managed dir; that content
# belongs in each tool's user-level skills dir, see AGENTS.md's "Skills" section.
.agents/skills/.system/
.agents/skills/.curated/
/.mimocode/.cron-lock

# --- Environment ---
.env

# --- Python ---
__pycache__/
*.pyc
.venv/

# --- IDE / OS ---
.DS_Store
.idea/
.vscode/
*.swp
*~

# --- Graphify ---
graphify-out/

# --- Cockpit ---
# The registry of known deployments and each one's cached reconcile results are
# per-checkout local state, not shared config.
cockpit/registry/

# --- Logs ---
*.log
