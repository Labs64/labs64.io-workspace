# Single source of truth for the CLI toolchain used across the Labs64.IO ecosystem.
#
# Read by:
#   * .devcontainer/post-create.sh           — what a developer's container installs
#   * `just doctor`                          — reports drift between this file and what is installed
#   * .github/actions/tool-versions          — exports every value as an env var in CI
#   * .github/actions/setup-k8s-tools        — installs helm / helmfile / k3d / just in CI
#   * .github/actions/setup-maven            — installs Maven in CI
#   * labs64.io-helm-charts/justfile         — via `set dotenv-path`
#
# This is the file for the CLI toolchain. The other "one file of pins" in the ecosystem:
#   * labs64.io-helm-charts/justfile.versions    — CRD sets applied outside Helm (Gateway API, Traefik CRDs)
#   * labs64.io-helm-charts/helmfile.yaml.gotmpl — third-party chart versions (next to their repositories)
#   * labs64.io-commons/labs64io-parent/pom.xml  — Java stack
#
# Plain KEY=VALUE (dotenv / shell-sourceable). Versions are written WITHOUT a leading "v";
# each consumer adds it where the upstream tag has one. Renovate bumps these through the
# `# renovate:` annotations (see default.json); `just check-pins` verifies that the few
# places which cannot read this file (devcontainer.json) still agree with it.

# renovate: datasource=github-releases depName=helm/helm extractVersion=^v(?<version>.*)$
HELM_VERSION=4.3.0
# renovate: datasource=github-releases depName=helmfile/helmfile extractVersion=^v(?<version>.*)$
HELMFILE_VERSION=1.8.1
# renovate: datasource=github-releases depName=databus23/helm-diff extractVersion=^v(?<version>.*)$
HELM_DIFF_VERSION=3.15.15
# renovate: datasource=github-releases depName=dadav/helm-schema
HELM_SCHEMA_VERSION=0.23.5
# renovate: datasource=github-releases depName=norwoodj/helm-docs extractVersion=^v(?<version>.*)$
HELM_DOCS_VERSION=1.14.2
# renovate: datasource=github-releases depName=k3d-io/k3d extractVersion=^v(?<version>.*)$
K3D_VERSION=5.9.0
# renovate: datasource=github-releases depName=derailed/k9s extractVersion=^v(?<version>.*)$
K9S_VERSION=0.51.0
# renovate: datasource=github-releases depName=casey/just
JUST_VERSION=1.58.0
# renovate: datasource=github-releases depName=hashicorp/terraform extractVersion=^v(?<version>.*)$
TERRAFORM_VERSION=1.16.5

# Maven, for CI and the dev container. Stays on the 3.9 line: Maven 3.10 changed the default plugin
# versions and the Central publishing plugin (0.11.0) then produced a bundle Central rejected
# (auditflow-api 0.1.1, 2026-10-08). Moving to 3.10 or 4 is a deliberate step, not a Renovate PR.
# renovate: datasource=maven depName=org.apache.maven:apache-maven
MAVEN_VERSION=3.9.16

# CI-only: the workflow linter run by this repository's own CI.
# renovate: datasource=github-releases depName=rhysd/actionlint extractVersion=^v(?<version>.*)$
ACTIONLINT_VERSION=1.7.12

# Language runtimes. Not Renovate-managed: moving one is a deliberate, ecosystem-wide
# decision (Dockerfile base images, devcontainer features and CI move together).
JAVA_VERSION=25
NODE_VERSION=26
PYTHON_VERSION=3.14
